{
  "name": "fsp-cartography",
  "version": "0.0.2",
  "private": true,
  "description": "Thin deterministic FSP Cartography kernel prototype",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:browser": "tsc -p tsconfig.browser.json",
    "prototype:lives": "npm run build && node scripts/build-lives-maathai-prototype.cjs",
    "test": "npm run build && node --test tests/acceptance/*.test.cjs tests/micro/*.test.cjs tests/unit/*.test.cjs",
    "test:acceptance": "npm run build && node --test tests/acceptance/*.test.cjs",
    "test:micro": "npm run build && node --test tests/micro/*.test.cjs",
    "test:unit": "npm run build && node --test tests/unit/*.test.cjs",
    "prototype:maathai-field": "npm run build && node scripts/build-maathai-field-prototype.cjs",
    "prototype:maathai-field2": "npm run build && node scripts/build-maathai-field2-prototype.cjs"
  }
}
